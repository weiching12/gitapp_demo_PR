{
  "name": "stock-insight-tw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.js",
    "build:cloudflare": "vite build --mode cloudflare",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --port 8787",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "seed": "node --env-file-if-exists=.dev.vars scripts/seed-market.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "vite": "^7.3.1",
    "wrangler": "^4.151.1"
  }
}
