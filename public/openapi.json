              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Security": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "sector",
          "market",
          "listedOn"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^(?:[0-9]{4,6}|[0-9]{5}[A-Z])$"
          },
          "name": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "listedOn": {
            "type": "string",
            "format": "date"
          },
          "assetType": {
            "type": "string",
            "enum": [
              "stock",
              "etf"
            ]
          }
        }
      },
      "Institution": {
        "type": "object",
        "required": [
          "name",
          "buy",
          "sell"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "buy": {
            "type": "number"
          },
          "sell": {
            "type": "number"
          }
        }
      },
      "Bar": {
        "type": "object",
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume",
          "institutions"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "open": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "low": {
            "type": "number"
          },
          "close": {
            "type": "number"
          },
          "volume": {
            "type": "number"
          },
          "institutions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Institution"
            }
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": [
          "schemaVersion",
          "source",
          "generation",
          "asOf",
          "updatedAt",
          "dates",
          "stocks",
          "chunks"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 2
          },
          "source": {
            "const": "twse"
          },
          "generation": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "format": "date"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            }
          },
          "stocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Security"
            }
          },
          "chunks": {
            "type": "array",
            "minItems": 128,
            "maxItems": 128,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StockSnapshot": {
        "type": "object",
        "required": [
          "schemaVersion",
          "source",
          "asOf",
          "updatedAt",
          "stock"
        ],
        "properties": {
          "schemaVersion": {
            "const": 2
          },
          "source": {
            "const": "twse"
          },
          "asOf": {
            "type": "string",
            "format": "date"
          },
          "updatedAt": {
            "type": "string"
          },
          "stock": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Security"
              },
              {
                "type": "object",
                "required": [
                  "history",
                  "tradingDates"
                ],
                "properties": {
                  "history": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Bar"
                    }
                  },
                  "tradingDates": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "StockCollection": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Security"
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "asOf",
              "updatedAt",
              "total",
              "offset",
              "limit"
            ],
            "properties": {
              "asOf": {
                "type": "string",
                "format": "date"
              },
              "updatedAt": {
                "type": "string"
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            }
          }
        }
      },
      "History": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bar"
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "symbol",
              "asOf",
              "updatedAt",
              "tradingDates"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "asOf": {
                "type": "string",
                "format": "date"
              },
              "updatedAt": {
                "type": "string"
              },
              "tradingDates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      },
      "Analysis": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "symbol",
              "latest",
              "signal",
              "priceHistory",
              "institutionalSummary"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "priceHistory": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "required": ["date", "close"],
                  "properties": {
                    "date": { "type": "string", "format": "date" },
                    "close": { "type": ["number", "null"] }
                  }
                }
              },
              "latest": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Bar"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "signal": {
                "type": "object",
                "required": [
                  "code",
                  "tone",
                  "label",
                  "reason"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "tone": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "institutionalSummary": {
                "type": "object"
              }
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "asOf",
              "sourceAsOf",
              "rulesVersion",
              "priceBasis",
              "settings"
            ],
            "properties": {
              "asOf": {
                "type": "string",
                "format": "date"
              },
              "sourceAsOf": {
                "type": "string",
                "format": "date"
              },
              "rulesVersion": {
                "const": "technical-v1"
              },
              "priceBasis": {
                "const": "unadjusted"
              },
              "settings": {
                "type": "object"
              }
            }
          }
        }
      },
      "Shard": {
        "type": "object",
        "required": [
          "generation",
          "index",
          "stocks"
        ],
        "properties": {
          "generation": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "stocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "symbol",
                "history"
              ],
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "history": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 12,
                    "maxItems": 12
                  }
                }
              }
            }
          }
        }
      },
      "Presence": {
        "type": "object",
        "required": [
          "online",
          "windowSeconds"
        ],
        "properties": {
          "online": {
            "type": "integer",
            "minimum": 0
          },
          "windowSeconds": {
            "const": 90
          }
        }
      },
      "PushConfig": {
        "type": "object",
        "required": [
          "enabled",
          "publicKey"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "publicKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PushSubscriptionState": {
        "type": "object",
        "required": [
          "subscribed"
        ],
        "properties": {
          "subscribed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
