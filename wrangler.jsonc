{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-insight-tw",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "MARKET_DATA",
      "id": "0894cb2466e84600ba35b848e748dc9a"
    }
  ],
  "d1_databases": [
    {
      "binding": "T86_DB",
      "database_name": "stockapps-t86",
      "database_id": "e3f87bdd-aff2-427f-9894-ac89bd9f5905",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "T86_HISTORY_RATIO": "0.90",
    "T86_EVENING_RATIO": "0.95",
    "MARKET_HISTORY_ENABLED": "1",
    "VAPID_PUBLIC_KEY": "BGansUEyeX9nFCl2LA9r_Va9cPozZo4NY3FByEjXNOB6CaPLsqex46OdZ9Xn2JOpUlQtX00avjjHYmcYj2045D4",
    "VAPID_SUBJECT": "https://stock-insight-tw.stock-insight-tw.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ONLINE_PRESENCE",
        "class_name": "OnlinePresence"
      },
      {
        "name": "MARKET_SYNC",
        "class_name": "MarketSyncCoordinator"
      },
      {
        "name": "MARKET_SUMMARY",
        "class_name": "MarketSummaryCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "presence-v1",
      "new_sqlite_classes": [
        "OnlinePresence"
      ]
    },
    {
      "tag": "market-sync-v1",
      "new_sqlite_classes": [
        "MarketSyncCoordinator"
      ]
    },
    {
      "tag": "market-summary-v1",
      "new_sqlite_classes": [
        "MarketSummaryCoordinator"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "30-59 10 * * mon-fri",
      "* 11-15 * * mon-fri"
    ]
  },
  "observability": {
    "enabled": true
  }
}
