{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-insight-tw",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "secrets": { "required": ["FINMIND_TOKEN"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "MARKET_DATA", "id": "0894cb2466e84600ba35b848e748dc9a" }],
  "triggers": { "crons": ["* 13-14 * * mon-fri", "0-29 15 * * mon-fri"] },
  "observability": { "enabled": true }
}
